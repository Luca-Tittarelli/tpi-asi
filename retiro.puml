@startuml Retiros

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

class Usuario {
  - nombre
  - apellido
  - email
  - telefono
  - retiro : Retiro
  - recordatorio : Recordatorio
  + crear()
  + mostrar()
  + conocerRetiro()
  + conocerRecordatorio()
  + calcularGastosTotales()
  + calcularGastosPorPeriodo()
}

class Retiro {
  - nombre
  - ubicacion
  - fechaInicio
  - fechaFin
  - duracion
  - costoTotal
  - requisitos
  - contactoOrganizador
  - estado : EstadoRetiro
  - actividad : Actividad
  - acompanante : Acompanante
  - pago : Pago
  - valoracion : Valoracion
  + crear()
  + mostrar()
  + conocerEstadoRetiro()
  + conocerActividad()
  + conocerAcompanante()
  + conocerPago()
  + conocerValoracion()
  + cambiarEstado()
  + agregarActividad()
  + agregarAcompanante()
  + registrarPago()
  + registrarValoracion()
  + calcularTotalGastos()
  + compartirInfo()
}
class EstadoRetiro {
  - valor
  + crear()
  + mostrar()
  + tomarValor()
  + mostrarValor()
}

class Actividad {
  - nombre
  - descripcion
  - fechaHora
  - costo
  + crear()
  + mostrar()
  + modificar()
}

class Acompanante {
  - nombre
  - apellido
  - telefono
  - vinculo : TipoVinculo
  + crear()
  + mostrar()
  + conocerTipoVinculo()
  + modificar()
}
class TipoVinculo {
  - nombreVinculo
  + crear()
  + mostrar()
}

class Pago {
  - monto
  - fechaPago
  - comprobante
  - metodoPago : MetodoPago
  - estadoPago : EstadoPago
  + crear()
  + mostrar()
  + conocerMetodoPago()
  + conocerEstadoPago()
  + registrarPago()
  + cambiarEstadoPago()
}

class MetodoPago {
  - nombreMetodo
  + crear()
  + mostrar()
}

class EstadoPago {
  - valor
  + crear()
  + mostrar()
}

class Valoracion {
  - puntuacion
  - comentario
  - fechaValoracion
  + crear()
  + mostrar()
  + modificar()
}

class Recordatorio {
  - fechaHora
  - mensaje
  - leido
  - tipo : TipoRecordatorio
  + crear()
  + mostrar()
  + conocerTipoRecordatorio()
  + notificar()
  + marcarComoLeido()
}
@enduml