@startuml Retiros

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

class Usuario {
  - nombre
  - apellido
  - email
  - telefono
  - retiros : Retiro
  + crear()
  + mostrar()
  + conocerRetiro()
  + calcularGastosTotales()
  + calcularGastosPorPeriodo()
}

class Retiro {
  - nombre
  - ubicacion
  - fechaInicio
  - fechaFin
  - duracion
  - costoTotal
  - requisitos
  - contactoOrganizador
  - estado : EstadoRetiro
  - recordatorios : Recordatorio
  - actividades : Actividad
  - acompanantes : Acompanante
  - pagos : Pago
  - valoracion : Valoracion
  + crear()
  + mostrar()
  + conocerEstadoRetiro()
  + conocerActividad()
  + conocerAcompanante()
  + conocerPago()
  + conocerValoracion()
  + cambiarEstado()
  + agregarActividad()
  + agregarAcompanante()
  + registrarPago()
  + registrarValoracion()
  + calcularTotalGastos()
  + compartirInfo()
  + filtrarRetiros()
}

class EstadoRetiro {
  - valor
  + crear()
  + mostrar()
  + tomarValor()
  + mostrarValor()
}

class Actividad {
  - nombre
  - descripcion
  - fechaHora
  - costo
  + crear()
  + mostrar()
  + modificar()
}

class Acompanante {
  - nombre
  - apellido
  - telefono
  - vinculo : TipoVinculo
  + crear()
  + mostrar()
  + conocerTipoVinculo()
  + modificar()
}

class TipoVinculo {
  - nombreVinculo
  + crear()
  + mostrar()
}

class Pago {
  - monto
  - fechaPago
  - comprobante
  - metodoPago : MetodoPago
  - estadoPago : EstadoPago
  + crear()
  + mostrar()
  + conocerMetodoPago()
  + conocerEstadoPago()
  + registrarPago()
  + cambiarEstadoPago()
}

class MetodoPago {
  - nombreMetodo
  + crear()
  + mostrar()
}

class EstadoPago {
  - valor
  + crear()
  + mostrar()
}

class Valoracion {
  - puntuacion
  - comentario
  - fechaValoracion
  + crear()
  + mostrar()
  + modificar()
}

class Recordatorio {
  - fechaHora
  - mensaje
  - leido
  - tipo : TipoRecordatorio
  + crear()
  + mostrar()
  + conocerTipoRecordatorio()
  + notificar()
  + marcarComoLeido()
}

class TipoRecordatorio {
  - nombreTipo
  + crear()
  + mostrar()
}

' Relacion desde Usuario
Usuario -right-> " 0..* " Retiro

' Relaciones desde Retiro
Retiro -up-> " 1 " EstadoRetiro
Retiro *-up-> " 0..* " Recordatorio
Retiro *-right-> " 0..1 " Valoracion
Retiro o-right-> " 0..* " Acompanante
Retiro *-down-> " 0..* " Actividad
Retiro *-down-> " 0..* " Pago

' Relacion de Recordatorio
Recordatorio -right-> " 1 " TipoRecordatorio

' Relacion de Acompanante
Acompanante -down-> " 1 " TipoVinculo

' Relaciones de Pago
Pago -down-> " 1 " MetodoPago
Pago -right-> " 1 " EstadoPago

@enduml